<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/widget_upsell_gradient"
    android:padding="16dp">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_mascot_wave"
            android:contentDescription="Lullio mascot waving" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:text="✨"
            android:textSize="12sp" />
    </FrameLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Upgrade to Pro"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#0a0a0a"
        android:layout_marginTop="6dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unlock home widgets"
        android:textSize="11sp"
        android:textColor="#4a5565"
        android:layout_marginTop="2dp" />
</LinearLayout>
