<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:id="@+id/widget_root">
    <TextView
        android:id="@+id/mood_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="😐"
        android:textSize="32sp" />
    <TextView
        android:id="@+id/mood_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Okay"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1E3A5F"
        android:layout_marginTop="6dp" />
    <LinearLayout
        android:id="@+id/mood_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center">
        <TextView
            android:id="@+id/mood_btn_1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="😢"
            android:textSize="18sp"
            android:layout_marginEnd="4dp" />
        <TextView
            android:id="@+id/mood_btn_2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="😔"
            android:textSize="18sp"
            android:layout_marginEnd="4dp" />
        <TextView
            android:id="@+id/mood_btn_3"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="😐"
            android:textSize="18sp"
            android:layout_marginEnd="4dp" />
        <TextView
            android:id="@+id/mood_btn_4"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="🙂"
            android:textSize="18sp"
            android:layout_marginEnd="4dp" />
        <TextView
            android:id="@+id/mood_btn_5"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="😊"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
