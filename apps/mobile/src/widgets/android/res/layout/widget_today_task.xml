<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp"
    android:id="@+id/widget_root">

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#0a0a0a" />
        <TextView
            android:id="@+id/task_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/3"
            android:textSize="11sp"
            android:textColor="#6a7282"
            android:background="@drawable/widget_chip_soft_blue"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginStart="6dp" />
        <!-- Stretch spacer -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_mascot_running"
            android:contentDescription="Mascot" />
    </LinearLayout>

    <!-- Task list container -->
    <LinearLayout
        android:id="@+id/task_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp" />

    <!-- Fallback when no task rows -->
    <TextView
        android:id="@+id/suggested_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Review project notes"
        android:textSize="13sp"
        android:textColor="#0a0a0a"
        android:maxLines="2"
        android:ellipsize="end"
        android:background="@drawable/widget_task_row_bg"
        android:padding="10dp"
        android:layout_marginTop="8dp" />
</LinearLayout>
